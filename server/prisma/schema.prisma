// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String              @id @default(uuid()) @db.Uuid
  fullName      String
  email         String              @unique
  passwordHash  String
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  isVerified    Boolean             @default(false)
  avatar        String?
  dateFormat    String?
  currency      String?
  phoneNumber   String?
  weekStart     WeekStart?
  language      LanguagePreference?
  accounts      Account[]
  transactions  Transaction[]
  categories    Category[]
  refreshTokens RefreshToken[]
  loans         Loan[]
  creditCards   CreditCard[]
  investments   Investment[]
}

enum LanguagePreference {
  english
  arabic
}

enum WeekStart {
  sun
  mon
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  tokenHash String    @unique
  createdAt DateTime  @default(now())
  usedAt    DateTime?
  expiresAt DateTime
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id            String        @id @default(uuid()) @db.Uuid
  name          String
  accountNumber String
  accountType   AccountType
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  isPrimary     Boolean       @default(false)
  isActive      Boolean       @default(true)
  userId        String        @db.Uuid
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions  Transaction[]

  @@unique([userId, name])
  @@unique([userId, accountNumber])
}

enum AccountType {
  cash
  checking
  savings
  salary
}

model Transaction {
  id              String          @id @default(uuid()) @db.Uuid
  merchant        String
  description     String
  isEdited        Boolean         @default(false)
  balanceAfter    Decimal         @db.Decimal(12, 3)
  type            TransactionType
  amount          Decimal         @db.Decimal(12, 3)
  statementRow    Int
  transactionDate DateTime        @db.Date
  updatedAt       DateTime        @updatedAt
  notes           String?
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  account         Account         @relation(fields: [accountId], references: [id], onDelete: Restrict)
  category        Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  userId          String          @db.Uuid
  accountId       String          @db.Uuid
  categoryId      String?         @db.Uuid
  transferGroupId String?         @db.Uuid
  loan            Loan?           @relation(fields: [loanId], references: [id], onDelete: SetNull)
  loanId          String?         @db.Uuid
  creditCard      CreditCard?     @relation(fields: [creditCardId], references: [id], onDelete: SetNull)
  creditCardId    String?         @db.Uuid

  @@index([transferGroupId])
  @@index([accountId, transactionDate, statementRow])
}

enum TransactionType {
  income
  expense
  transfer
}

model Category {
  id           String          @id @default(uuid()) @db.Uuid
  name         String
  color        String
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  appliesTo    TransactionType
  transactions Transaction[]
  userId       String          @db.Uuid

  @@unique([userId, appliesTo, name])
}

model Loan {
  id                  String        @id @default(uuid()) @db.Uuid
  installment         Decimal       @db.Decimal(12, 3)
  invoiceNumber       String
  originalAmount      Decimal       @db.Decimal(12, 3)
  startDate           DateTime      @db.Date
  lastInstallmentDate DateTime      @db.Date
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  user                User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId              String        @db.Uuid
  transactions        Transaction[]

  @@unique([userId, invoiceNumber])
}

model CreditCard {
  id                 String        @id @default(uuid()) @db.Uuid
  limit              Decimal       @db.Decimal(12, 3)
  type               CardType
  cardNumber         String
  outstandingBalance Decimal       @db.Decimal(12, 3)
  expiryDate         DateTime      @db.Date
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  transactions       Transaction[]
  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId             String        @db.Uuid

  @@unique([userId, cardNumber])
}

enum CardType {
  installment
  fullDeduction
}

model Investment {
  id             String             @id @default(uuid()) @db.Uuid
  asset          String
  category       InvestmentCategory
  shares         Decimal            @db.Decimal(20, 8)
  purchasePrice  Decimal            @db.Decimal(20, 8)
  currentPrice   Decimal            @db.Decimal(20, 8)
  platform       String?
  symbol         String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  priceUpdatedAt DateTime           @default(now())
  userId         String             @db.Uuid
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum InvestmentCategory {
  stocks
  ETF
  crypto
  funds
  commodity
  other
}
